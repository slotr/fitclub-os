{
  "expo": {
    "name": "FitClub",
    "slug": "fitclub-mobile",
    "scheme": "fitclub",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.fitclub.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitclub.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-camera",
      "expo-secure-store",
      "expo-sqlite",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Read your workout and biometric history.",
          "healthUpdatePermission": "Save your gym workouts to Apple Health."
        }
      ],
      [
        "react-native-health-connect",
        {
          "permissions": [
            "android.permission.health.WRITE_EXERCISE",
            "android.permission.health.READ_EXERCISE"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac372abb-a26a-4d87-9253-b7e7b5ce4897"
      }
    },
    "owner": "hhhkaraca"
  }
}
