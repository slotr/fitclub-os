# Copy to .env.production and fill in. Compose loads it for the web service;
# Caddy reads DOMAIN/WEB_HOST from the same file via docker-compose env_file.

# --- Reverse proxy ---
DOMAIN=fitclub.example.com

# --- Supabase (self-hosted on the same VPS) ---
# Public URL = the domain you serve Kong on (see supabase compose).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.fitclub.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Internal URL the Next.js server uses inside the docker network. Faster +
# avoids round-tripping through Caddy. Only used by server-side code.
SUPABASE_INTERNAL_URL=http://kong:8000

# --- Postgres ---
# Use the pgbouncer pool if you turn one on; otherwise the postgres service.
DATABASE_URL=postgres://postgres:CHANGE_ME@db:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=https://fitclub.example.com

# --- Crypto webhook (fail-closed if unset in production) ---
# Generate with: openssl rand -hex 32
CRYPTO_WEBHOOK_SECRET=

# --- Stripe (optional, retry + dunning) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend, optional, dunning + magic links) ---
RESEND_API_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
