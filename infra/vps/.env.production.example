# Copy to .env.production and fill in. docker-compose.app.yml loads it for
# the web container and reads the build args + SUPABASE_NETWORK from it.

# --- Supabase (self-hosted on the same VPS) ---
# Public base URL — single domain, the host nginx vhost path-routes the
# Supabase /auth/v1, /rest/v1, ... paths to Kong.
NEXT_PUBLIC_SUPABASE_URL=https://fms.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Docker network created by the Supabase compose stack. Find it with:
#   docker network ls | grep supabase
SUPABASE_NETWORK=supabase_default

# --- Postgres ---
# Inside the shared docker network the Supabase database is reachable as
# the `db` service.
DATABASE_URL=postgres://postgres:CHANGE_ME@db:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=https://fms.example.com

# --- Crypto webhook (fail-closed if unset in production) ---
# Generate with: openssl rand -hex 32
CRYPTO_WEBHOOK_SECRET=

# --- Stripe (optional, retry + dunning) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend, optional, dunning + magic links) ---
RESEND_API_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
