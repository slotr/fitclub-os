{$DOMAIN} {
	encode zstd gzip
	reverse_proxy {$WEB_HOST}

	# Long cache for Next.js immutable assets.
	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	# Basic security headers (Next ships CSP via headers() if you add one).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}

	log {
		output stdout
		format console
	}
}
